<!-- Interactive Script for Slider and Tabs -->
<script>
    (function initHomeInteractions() {
      // Photo Slider
      const slides = document.querySelectorAll('#hero-slider .slide');
      const dots = document.querySelectorAll('.slider-dot');
      const btnPrev = document.getElementById('slider-prev');
      const btnNext = document.getElementById('slider-next');
      let currentSlide = 0;
      let slideTimer = null;

      function updateSlide(index) {
        if (!slides.length) return;
        currentSlide = (index + slides.length) % slides.length;
        slides.forEach((s, i) => {
          if (i === currentSlide) {
            s.classList.remove('opacity-0', 'pointer-events-none');
            s.classList.add('opacity-100');
          } else {
            s.classList.add('opacity-0', 'pointer-events-none');
            s.classList.remove('opacity-100');
          }
        });

        dots.forEach((d, i) => {
          if (i === currentSlide) {
            d.className = 'slider-dot w-7 h-2 rounded-full bg-primary-container transition-all';
          } else {
            d.className = 'slider-dot w-2 h-2 rounded-full bg-on-surface/30 hover:bg-on-surface/60 transition-all';
          }
        });
      }

      function nextSlide() {
        updateSlide(currentSlide + 1);
      }

      function startTimer() {
        clearInterval(slideTimer);
        slideTimer = setInterval(nextSlide, 6500);
      }

      if (btnNext && btnPrev) {
        btnNext.addEventListener('click', () => { nextSlide(); startTimer(); });
        btnPrev.addEventListener('click', () => { updateSlide(currentSlide - 1); startTimer(); });
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0', 10);
          updateSlide(idx);
          startTimer();
        });
      });

      startTimer();

      // Notice Board Filtering
      const tabs = document.querySelectorAll('.circular-tab');
      const noticeRows = document.querySelectorAll('.notice-row');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => {
            t.className = 'circular-tab px-4 py-1.5 rounded-full font-label-sm text-label-sm bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-white transition-all';
          });
          tab.className = 'circular-tab px-4 py-1.5 rounded-full font-label-sm text-label-sm bg-primary-container text-on-primary shadow-sm transition-all';

          const cat = tab.getAttribute('data-category');
          noticeRows.forEach(row => {
            const rowType = row.getAttribute('data-type');
            if (cat === 'all' || rowType === cat) {
              row.style.display = 'flex';
            } else {
              row.style.display = 'none';
            }
          });
        });
      });
    })();
  </script>
